{
  "expo": {
    "name": "Llogarite",
    "slug": "mobile",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "llogarite",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.rmtech.llogarite",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:llogarite.site"
      ]
    },
    "android": {
      "package": "com.rmtech.llogarite",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "llogarite.site",
              "pathPrefix": "/shoku"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 39,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3717243561831400~1004453223",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Llogarite needs access to your photos so you can upload an invoice image.",
          "cameraPermission": "Llogarite needs access to your camera so you can scan the QR code on a receipt, or take a photo of an invoice or your profile picture."
        }
      ],
      "./plugins/withWindowsNinjaFix",
      "./plugins/withReleaseMatchingFallbacks",
      "./plugins/withMonorepoMetroRoot",
      "./plugins/withReleaseSigning",
      "./plugins/withMinifyRelease",
      "./plugins/withoutStatusBarColor",
      "./plugins/withPortraitOnPhones",
      "./plugins/withPortraitOnIos",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8f00b960-05ad-435f-bf5d-0a9fc9d338f9"
      }
    }
  }
}
