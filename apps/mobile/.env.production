# Production build values. Loaded automatically when NODE_ENV=production,
# which is what the Gradle release task sets when it runs `expo export:embed`.
#
# Why this file exists: local `gradlew bundleRelease` does NOT read eas.json's
# `production.env` block -- that only applies to EAS cloud builds. Local builds
# read the .env files, and plain `.env` holds dev-only values (loopback API URL
# via adb reverse). Without this file a locally-built release AAB ships pointing
# at 127.0.0.1 and cannot reach the backend at all.
#
# Precedence: .env.production wins over .env, so `.env` stays dev-only.
# Keep these in sync with eas.json's production.env block.
#
# No secrets here -- EXPO_PUBLIC_* values are inlined into the client bundle
# by design and are already public in eas.json.

EXPO_PUBLIC_API_URL=https://api.llogarite.site/api
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=327785849083-5hu7mig1s2pstkn9g1tqh8sgsf49phoe.apps.googleusercontent.com
